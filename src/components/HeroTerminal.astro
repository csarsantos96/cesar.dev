---
import { skillGroups } from '../lib/data';

const stack = skillGroups
  .map(({ key, tags }) => ({ key, names: tags.filter((tag) => !tag.learning).map((tag) => tag.name) }))
  .filter(({ names }) => names.length > 0);
const goals = [
  { key: 'career', names: ['Security Engineering', 'DevOps / SRE'] },
  ...skillGroups
    .map(({ key, tags }) => ({ key, names: tags.filter((tag) => tag.learning).map((tag) => tag.name) }))
    .filter(({ names }) => names.length > 0),
];
---
<div class="terminal">
  <div class="terminal-bar">
    <span class="t-dot t-red" />
    <span class="t-dot t-yellow" />
    <span class="t-dot t-green" />
    <span class="terminal-title">cesar@cesarsantos.dev — zsh</span>
  </div>
  <div class="terminal-body">
    <div class="t-hint t-out">Digite um comando e pressione Enter. Use help para ver todos.</div>
    <div class="t-history" data-history role="log" aria-label="Respostas do terminal" aria-live="polite"></div>
    <form class="t-input-row" data-terminal-form>
      <span class="t-prompt" aria-hidden="true">→</span>
      <input name="command" aria-label="Comando do terminal" placeholder="whoami" autocomplete="off" spellcheck="false" autocapitalize="off" />
    </form>
    <template data-output="stack">
    <div class="t-stack">
      <div class="t-comment">{'{'}</div>
      {stack.map(({ key, names }, index) => (
        <div class="t-json-line"><span class="t-key">{JSON.stringify(key)}</span><span class="t-comment">: </span><span class="t-val">[{names.map((name, nameIndex) => (<>{nameIndex > 0 && <>,<wbr /></>}{JSON.stringify(name)}</>))}]{index < stack.length - 1 ? ',' : ''}</span></div>
      ))}
      <div class="t-comment">{'}'}</div>
    </div>

    </template>
    <template data-output="goals">
    <div class="t-comment">{'{'}</div>
    {goals.map(({ key, names }, index) => (
      <div class="t-json-line"><span class="t-key">{JSON.stringify(key)}</span><span class="t-comment">: </span><span class="t-val">{JSON.stringify(names)}{index < goals.length - 1 ? ',' : ''}</span></div>
    ))}
    <div class="t-comment">{'}'}</div>

    </template>
    <template data-output="certs">
    <div class="t-out" style="white-space:pre">OCI Foundations     <span style="color:var(--t-green,#34d399)">[▓▓▓▓▓▓▓▓▓▓]</span> <span style="color:var(--t-green,#34d399)">100% completed</span></div>
    <div class="t-out" style="white-space:pre">OCI AI Foundations  <span style="color:var(--t-green,#34d399)">[▓▓▓▓▓▓▓▓▓▓]</span> <span style="color:var(--t-green,#34d399)">100% completed</span></div>
    <div class="t-out" style="white-space:pre">AWS Cloud Practitioner <span style="color:var(--t-yellow,#fbbf24)">[▓▓▓▓▓▓▓▓▓░]</span> <span style="color:var(--t-yellow,#fbbf24)">90% — exam pending</span></div>
    <div class="t-comment">// studying via LINUXtips guide</div>
    <div class="t-out" style="white-space:pre">CKAD  <span style="color:var(--t-yellow,#fbbf24)">[▓░░░░░░░░░]</span> <span style="color:var(--t-yellow,#fbbf24)">next</span></div>
    <div class="t-out" style="white-space:pre">CKA   <span style="color:var(--t-muted,#7c6f8f)">[░░░░░░░░░░]</span> <span style="color:var(--t-muted,#7c6f8f)">planned</span></div>
    <div class="t-out" style="white-space:pre">KCNA  <span style="color:var(--t-muted,#7c6f8f)">[░░░░░░░░░░]</span> <span style="color:var(--t-muted,#7c6f8f)">planned</span></div>
    <div class="t-out" style="white-space:pre">KCSA  <span style="color:var(--t-muted,#7c6f8f)">[░░░░░░░░░░]</span> <span style="color:var(--t-muted,#7c6f8f)">planned</span></div>
    <div class="t-out" style="white-space:pre">CKS   <span style="color:var(--t-muted,#7c6f8f)">[░░░░░░░░░░]</span> <span style="color:var(--t-muted,#7c6f8f)">planned</span></div>

    </template>
    <template data-output="work">
    <div class="t-out">open to work</div>

    </template>
    <div style="margin-top:8px"><span class="t-prompt">→</span> <span class="t-cmd">tail -f /var/log/api.log</span></div>
    <div id="log-tail" data-log-tail></div>
  </div>
</div>

<script>
  const terminal = document.querySelector('.terminal');
  const form = terminal?.querySelector<HTMLFormElement>('[data-terminal-form]');
  const input = form?.querySelector<HTMLInputElement>('input');
  const history = terminal?.querySelector<HTMLElement>('[data-history]');
  if (terminal && form && input && history) {
    const commands: Record<string, string> = {
      'cat stack.json': 'stack', 'cat goals.json': 'goals',
      'cert-path --status': 'certs', 'echo "open to work"': 'work',
    };
    const previous: string[] = [];
    let position = 0;
    function execute(raw: string) {
      const command = raw.trim().replace(/\s+/g, ' ');
      if (!command) return;
      previous.push(command);
      position = previous.length;
      input!.value = '';
      if (command === 'clear') {
        history!.replaceChildren();
        return;
      }
      const entry = document.createElement('div');
      entry.className = 't-entry';
      const prompt = document.createElement('div');
      prompt.className = 't-cmd';
      prompt.textContent = `→ ${command}`;
      entry.append(prompt);
      const template = terminal!.querySelector<HTMLTemplateElement>(`template[data-output="${commands[command] || ''}"]`);
      if (template) {
        entry.append(template.content.cloneNode(true));
      } else {
        const output = document.createElement('div');
        output.className = 't-out';
        output.textContent = command === 'whoami'
          ? 'César Santos · Software Engineer (Backend)'
          : command === 'help'
            ? 'whoami · cat stack.json · cat goals.json · cert-path --status · echo "open to work" · clear'
            : `Comando não encontrado: ${command}. Digite help.`;
        entry.append(output);
      }
      history!.append(entry);
      while (history!.children.length > 30) history!.firstElementChild?.remove();
      history!.scrollTop = history!.scrollHeight;
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      execute(input.value);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
      event.preventDefault();
      position = Math.max(0, Math.min(previous.length, position + (event.key === 'ArrowUp' ? -1 : 1)));
      input.value = previous[position] || '';
    });
  }

  const ENDPOINTS = [
    { method: 'GET', path: '/api/v1/health', status: 200, tag: 'info' },
    { method: 'POST', path: '/api/v1/auth/token', status: 201, tag: 'info' },
    { method: 'POST', path: '/api/v1/transcribe', status: 202, tag: 'info' },
    { method: 'GET', path: '/api/v1/embeddings/query', status: 200, tag: 'info' },
    { method: 'DELETE', path: '/api/v1/sessions/e91c', status: 204, tag: 'warn' },
    { method: 'GET', path: '/api/v1/metrics', status: 200, tag: 'info' },
  ];
  const TAG_COLOR: Record<string, string> = {
    info: 'var(--term-accent, #c084fc)', warn: 'var(--t-yellow, #fbbf24)', error: 'var(--t-red, #f87171)',
  };
  function makeLine() {
    const e = ENDPOINTS[Math.floor(Math.random() * ENDPOINTS.length)];
    return { ts: new Date().toISOString(), ...e, ms: (Math.random() * 90 + 4).toFixed(1) };
  }
  function render(host: HTMLElement, lines: any[]) {
    host.innerHTML = lines.map((l, i) => {
      const newest = i === lines.length - 1;
      return `<div class="t-out" style="white-space:nowrap;opacity:${newest ? 1 : 0.5};transition:opacity 0.4s ease">`
        + `<span style="opacity:0.55">[${l.ts}]</span> `
        + `<span style="color:${TAG_COLOR[l.tag]}">[${l.tag}]</span> `
        + `<span style="font-weight:600">${l.method}</span> ${l.path} `
        + `<span style="opacity:0.5">${l.status}</span> `
        + `<span style="opacity:0.55">${l.ms}ms</span>`
        + (newest ? '<span class="cursor"></span>' : '')
        + `</div>`;
    }).join('');
  }
  const host = document.querySelector('[data-log-tail]') as HTMLElement | null;
  if (host) {
    let lines = Array.from({ length: 3 }, makeLine);
    render(host, lines);
    let paused = false;
    host.addEventListener('mouseenter', () => (paused = true));
    host.addEventListener('mouseleave', () => (paused = false));
    const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      setInterval(() => {
        if (paused) return;
        lines = [...lines.slice(-3), makeLine()];
        render(host, lines);
      }, 1100);
    }
  }
</script>
