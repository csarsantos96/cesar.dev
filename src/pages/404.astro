---
import '../styles/global.css';
import { translations } from '../lib/i18n';
const t = translations.pt.notFound;
---
<!doctype html>
<html lang="pt-BR">
  <head><meta charset="utf-8" /><title>{t.code} — {t.title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" /></head>
  <body>
    <section class="section-wrap" style="min-height:80vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:1rem">
      <div class="section-tag" style="font-size:clamp(3rem,10vw,6rem)">{t.code}</div>
      <h1 class="section-title" style="margin-bottom:1rem">{t.title}</h1>
      <p style="color:var(--text2);max-width:32rem">{t.desc}</p>
      <a href="/" class="btn-primary">{t.btn}</a>
    </section>
  </body>
</html>
